# Canonical URL webu (bez lomítka na konci)
NEXT_PUBLIC_SITE_URL=https://simonracko.cz

# Resend – odesílání kontaktního formuláře
# 1) Účet: https://resend.com
# 2) API key: https://resend.com/api-keys
# 3) Doménu simonracko.cz ověř v Resend → Domains (DNS záznamy)
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=kontakt@simonracko.cz

# Do ověření domény nech výchozí Resend sender.
# Po ověření změň např. na: Portfolio <kontakt@simonracko.cz>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
